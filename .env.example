# OP-06 Triage Service — Environment Template (.env.example)
# Copy to .env and adjust as necessary.

# Runtime Process Flags (Required on macOS ARM64 to prevent OpenMP / Rayon SIGSEGV crash)
OMP_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Environment & Secrets
ENVIRONMENT=development
PORT=8000
# API_SECRET_KEY=your_secret_here
